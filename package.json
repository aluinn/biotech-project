  "description": "Search any protein and explore its AlphaFold-predicted 3D structure, coloured by confidence.",
  "license": "MIT",
  "author": "Aluinn McDonald",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aluinn/biotech-project.git"
  },
  "homepage": "https://biotech-project-six.vercel.app",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "check": "node --check app.js && node --check helpers.js && node --check scripts/serve.mjs && node --check scripts/capture-screenshots.mjs && node --check scripts/benchmark.mjs",
    "test": "node --test test/helpers.test.js",
    "test:e2e": "playwright test",
